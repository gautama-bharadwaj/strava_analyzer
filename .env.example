# Strava API credentials: create an app at https://www.strava.com/settings/api
# and set its "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Optional
# STRAVADASH_DATA_DIR=data        # where strava.db and tokens.json live
# STRAVADASH_AUTH_PORT=8765       # local port used once during `stravadash auth`
